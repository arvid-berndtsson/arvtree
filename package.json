{
  "name": "arvtree",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b && node scripts/verify-build.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "wrangler pages dev dist/client --port 4173",
    "check": "npm run format:check && npm run lint && npm run build",
    "deploy": "npm run build && wrangler pages deploy",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.53",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "sharp": "^0.35.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
